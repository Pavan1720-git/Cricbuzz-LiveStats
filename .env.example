# ─── Cricket API Configuration ───────────────────────────────────────────────
# Obtain a key from https://rapidapi.com/cricapi/api/cricbuzz-cricket (or similar)
CRICKET_API_KEY=
CRICKET_API_HOST=cricbuzz-cricket.p.rapidapi.com
CRICKET_API_BASE_URL=https://cricbuzz-cricket.p.rapidapi.com

# ─── Database Configuration ───────────────────────────────────────────────────
# MySQL  : mysql+pymysql://user:password@host:3306/cricbuzz_db
# SQLite : sqlite:///cricbuzz.db   (auto-used when MySQL is unavailable)
DATABASE_URL=sqlite:///cricbuzz.db

# ─── Application Settings ────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEMO_MODE=true               # true => use sample data; false => use live API
API_CACHE_SECONDS=60         # seconds to cache API responses
API_TIMEOUT_SECONDS=10       # HTTP request timeout
